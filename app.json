{
  "expo": {
    "name": "Specskart POS",
    "slug": "specskart-pos",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "specskartpos",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.specskart.pos",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f6f3ee"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      ["expo-camera", { "cameraPermission": "Specskart POS uses the camera to scan product barcodes." }]
    ]
  }
}
