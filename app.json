{
  "expo": {
    "name": "Specskart POS",
    "slug": "specskart-pos",
    "version": "1.14.0",
    "orientation": "portrait",
    "scheme": "specskartpos",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.specskart.pos",
      "versionCode": 19,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2342F0"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      ["expo-camera", { "cameraPermission": "Specskart POS uses the camera to scan product barcodes." }],
      ["expo-image-picker", { "photosPermission": "Specskart POS uses your photos to add frame pictures.", "cameraPermission": "Specskart POS uses the camera to photograph frames." }]
    ]
  }
}
